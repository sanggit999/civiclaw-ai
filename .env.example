# Supabase Configuration
# Lấy từ: Project Settings -> API trên dashboard https://supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Database Direct Connection (cho migrations & direct SQL nếu cần)
# postgres://postgres.[project-id]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
